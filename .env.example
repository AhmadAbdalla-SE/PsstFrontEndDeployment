# Where the Psst backend is listening. The dev server prints the port on boot
# ("Example app listening on port ..."), and it comes from PORT in the
# backend's .env.development.
VITE_API_BASE_URL=http://localhost:3000

# Google OAuth web client id, used by the "Continue with Google" button.
# It must be the same value as WEB_CLIENT_IDS in the backend .env, and
# http://localhost:5173 must be listed as an authorised JavaScript origin in
# the Google Cloud console.
VITE_GOOGLE_CLIENT_ID=
